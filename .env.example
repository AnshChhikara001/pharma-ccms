# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=ccms
POSTGRES_PASSWORD=ccms_dev_password
POSTGRES_DB=ccms
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── AI provider ─────────────────────────────────────────────────────────────
# One of: gemini | openai | mock
# 'mock' is deterministic, free, and is what CI and the test suite always use.
AI_PROVIDER=gemini

# Free tier, supports text + image input at no charge. Get one at aistudio.google.com
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Paid fallback. gpt-5-nano is $0.05/1M in, $0.40/1M out.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# ─── Cost governor ───────────────────────────────────────────────────────────
# Hard cap. A call whose projected cost would exceed this raises BudgetExceeded
# BEFORE contacting the provider. This is what protects the budget.
AI_BUDGET_USD=0.70
AI_CACHE_ENABLED=true
AI_RECURSION_LIMIT=8

# ─── Frontend ────────────────────────────────────────────────────────────────
# Where the Vite dev server proxies /api and /health. Change this if port 8000
# is already taken on your machine - no tracked file needs editing.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_PORT=5173
