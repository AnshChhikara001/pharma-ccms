          },
          "value": {
            "title": "Value",
            "type": "string"
          }
        },
        "required": [
          "value",
          "label"
        ],
        "title": "EnumOption",
        "type": "object"
      },
      "VocabularyResponse": {
        "description": "Every enum the intake form and filters need, in one round trip.",
